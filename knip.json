{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["**/tests/**"],
  "workspaces": {
    ".": {
      "ignore": ["tests/**"]
    },
    "packages/theo": {
      "entry": [
        "src/adapters/node.ts",
        "src/adapters/bun.ts",
        "src/adapters/cloudflare.ts",
        "src/adapters/deno-deploy.ts",
        "src/adapters/vercel.ts",
        "src/adapters/netlify.ts",
        "src/adapters/aws-lambda.ts",
        "src/adapters/static.ts",
        "src/devtools/index.ts",
        "src/core/contracts/index.ts",
        "src/server/webhook/providers/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/http": {
      "entry": ["src/bridge/runtime/bun.ts", "src/bridge/runtime/deno.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/agents": {
      "entry": ["src/theokit-plugin.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/create-theokit": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": [
    "react",
    "react-dom",
    "react-router",
    "ws",
    "expect-type",
    "lint-staged",
    "pg",
    "@types/pg"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "warn"
  },
  "tags": ["-@knipignore"]
}
