{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    ".claude/**",
    "**/templates/**",
    "**/examples/**",
    "**/tests/**",
    "**/fixtures/**",
    "**/*.bench.ts",
    "**/tests/benchmark/**",
    "**/*.d.mts"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js,mjs,sh}"],
      "ignore": ["my-test/**", "fixtures/**", "examples/**", "tests/**"]
    },
    "packages/theo": {
      "entry": [
        "src/adapters/node.ts",
        "src/adapters/bun.ts",
        "src/adapters/cloudflare.ts",
        "src/adapters/deno-deploy.ts",
        "src/adapters/vercel.ts",
        "src/adapters/netlify.ts",
        "src/adapters/aws-lambda.ts",
        "src/adapters/static.ts",
        "src/devtools/entry.tsx",
        "src/devtools/index.ts",
        "src/core/contracts/index.ts",
        "src/server/webhook/providers/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/create-theo": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/http": {
      "entry": [
        "src/index.ts",
        "src/theokit-plugin.ts",
        "src/app.ts",
        "src/runtime-node.ts",
        "src/bridge/runtime/bun.ts",
        "src/bridge/runtime/deno.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@theokit/agents"]
    },
    "packages/agents": {
      "entry": [
        "src/index.ts",
        "src/bridge-entry.ts",
        "src/testing/index.ts",
        "src/theokit-plugin.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/create-theokit": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": [
    "react",
    "react-dom",
    "react-router",
    "ws",
    "drizzle-orm",
    "postgres",
    "expect-type",
    "lint-staged"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "warn"
  }
}
