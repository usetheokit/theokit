{
  "openapi": "3.1.0",
  "info": {
    "title": "TheoKit Golden Fixture",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/events": {
      "post": {
        "operationId": "post_events",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["click"]
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": ["kind", "x", "y"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["keystroke"]
                      },
                      "key": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "required": ["kind", "key"]
                  }
                ],
                "discriminator": {
                  "propertyName": "kind"
                }
              }
            }
          }
        }
      }
    }
  }
}
