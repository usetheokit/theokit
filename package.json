{
  "name": "theokit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest --typecheck.only --run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "verify:published": "node scripts/verify-published-no-workspace.mjs",
    "validate:publint": "npx publint packages/theo && npx publint packages/create-theokit",
    "validate:attw": "npx @arethetypeswrong/cli --pack packages/theo --ignore-rules cjs-resolves-to-esm no-resolution",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:strict": "knip --strict",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:audit": "pnpm audit --prod --audit-level=high",
    "check:bundle": "bash scripts/check-bundle-budget.sh",
    "check:deps": "dependency-cruiser packages/theo/src --config .dependency-cruiser.cjs",
    "check:naming": "ls-lint",
    "check:direction": "node scripts/check-package-direction.mjs",
    "check:all": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm knip && pnpm check:licenses && pnpm check:audit && pnpm check:direction",
    "try:scaffold": "tsx packages/create-theokit/src/cli.ts my-test",
    "try:dev": "cd my-test && npx tsx ../packages/theo/src/cli/index.ts dev",
    "try:clean": "node -e \"const fs=require('fs');fs.rmSync('my-test',{recursive:true,force:true})\"",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm sync:templates",
    "release": "pnpm build && changeset publish",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:secrets": "bash scripts/prevent-secrets.sh",
    "sync:templates": "node scripts/sync-template-versions.mjs --write",
    "check:templates": "node scripts/sync-template-versions.mjs",
    "theo-ui:link": "bash scripts/theo-ui-link.sh",
    "theo-ui:unlink": "bash scripts/theo-ui-unlink.sh",
    "openapi:regen-fixtures": "tsx scripts/regen-openapi-fixtures.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@ls-lint/ls-lint": "^2.3.1",
    "@playwright/test": "^1.61.0",
    "@theokit/sdk": "^4.1.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "ai": "^7.0.14",
    "autocannon": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "db0": "^0.3.4",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expect-type": "^1.3.0",
    "globals": "^15.15.0",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14",
    "postgres": "^3.4.9",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "unplugin-swc": "^1.5.9",
    "unstorage": "^1.17.5",
    "vitest": "^4.1.9",
    "wrangler": "^4.102.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.0.0",
      "eslint-plugin-sonarjs>minimatch": "^10.2.3"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
