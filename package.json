{
  "name": "theokit-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest --typecheck.only --run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 build",
    "validate:publint": "npx publint packages/theo && npx publint packages/agents && npx publint packages/http && npx publint packages/presenter && npx publint packages/tauri && npx publint packages/create-theokit",
    "validate:attw": "npx @arethetypeswrong/cli --pack packages/theo --ignore-rules cjs-resolves-to-esm no-resolution",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:strict": "knip --strict",
    "check:deps": "dependency-cruiser packages/theo/src --config .dependency-cruiser.cjs",
    "check:naming": "ls-lint",
    "check:all": "pnpm build && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm knip && pnpm check:docs",
    "try:scaffold": "tsx packages/create-theokit/src/cli.ts my-test && tsx scripts/link-scaffold-to-workspace.ts my-test",
    "try:dev": "cd my-test && npx tsx ../packages/theo/src/cli/index.ts dev",
    "try:clean": "node -e \"const fs=require('fs');fs.rmSync('my-test',{recursive:true,force:true})\"",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/verify-version-not-published.mjs",
    "release": "pnpm build && node scripts/check-pack-no-workspace.mjs && changeset publish",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:pack-no-workspace": "node scripts/check-pack-no-workspace.mjs",
    "verify:version-collision": "node scripts/verify-version-not-published.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:docs": "node scripts/check-doc-citations.mjs",
    "check:audit": "pnpm audit --prod --audit-level=high",
    "typecheck:fast": "tsc --noEmit"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@ls-lint/ls-lint": "^2.3.1",
    "@theokit/presenter": "workspace:*",
    "@theokit/sdk": "^4.52.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "better-sqlite3": "^12.11.1",
    "db0": "^0.3.4",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expect-type": "^1.3.0",
    "globals": "^15.15.0",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.2",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "unstorage": "^1.17.5",
    "vitest": "^4.1.9",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "unrs-resolver"
    ],
    "overrides": {
      "zod": "^4.0.0",
      "eslint-plugin-sonarjs>minimatch": "^10.2.3",
      "react-router@>=7.12.0 <7.18.2": ">=7.18.2",
      "postcss@<8.5.18": ">=8.5.18",
      "nanoid@<3.3.17": ">=3.3.17"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.1"
  },
  "peerDependencies": {
    "@theokit/sdk": "^4.49.0"
  }
}
