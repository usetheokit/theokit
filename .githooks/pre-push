#!/usr/bin/env bash
# pre-push hook — local build + typecheck gate.
#
# Closes usetheodev/theokit#9-class regressions: a build-breaking change
# (e.g. a dropped `export` on an internal symbol — #51) used to reach
# `develop` because theokit had NO local pre-push gate. The package build
# (tsup DTS = tsc) is the deterministic catch — the unit suites run in CI.
# See packages/*/tsup.config.ts and .github/workflows/ci.yml.
#
# CI skip: this is a DEVELOPER push-protection hook. In CI (and the
# changesets release action's internal git push of Version PR branches/tags)
# the workflow runs its own explicit gates. core.hooksPath is re-applied by
# the `prepare` script on every `pnpm install`, so without this guard the
# hook would otherwise gate CI git operations.
if [ "${CI:-}" = "true" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
  echo "→ pre-push: CI detected — skipping local dev gate (CI runs its own gates)."
  exit 0
fi

set -e

# Node 22.12+ gate — theokit is validated only in its declared engine.
#
# The check runs BEFORE any nvm switch, and the switch happens only if the
# check fails. `nvm use` used to run unconditionally, and it does not merely
# satisfy the gate — it REPLACES the caller's toolchain with whatever .nvmrc
# names. A developer on a newer 22.x that satisfies the engine was moved onto
# 22.12.0, which is a different prefix with its own global bin, and pnpm
# installed under the first one is simply not there under the second. The hook
# then failed on a toolchain it had created itself.
node_major_of() { echo "$1" | sed -E 's/^v([0-9]+)\..*/\1/'; }

node_version="$(node --version 2>/dev/null || echo "v0.0.0")"
if [ "$(node_major_of "$node_version")" -lt 22 ] && [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
  nvm use --silent >/dev/null 2>&1 || true
  node_version="$(node --version 2>/dev/null || echo "v0.0.0")"
fi

if [ "$(node_major_of "$node_version")" -lt 22 ]; then
  echo "✗ pre-push: Node ${node_version} detected, but >=v22.12.0 is required (see engines)."
  echo "  Run: nvm use   (respects .nvmrc)"
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo ""
  echo "✗ pre-push: pnpm is not on PATH inside the hook — NOTHING was verified."
  echo "  This is not a build failure. The build never ran. Git hooks get a"
  echo "  minimal environment, so a version manager's shims may be absent — and"
  echo "  from here that is indistinguishable from a real break unless one of"
  echo "  them says so. Reporting 'build failed' for a build that never started"
  echo "  is how a gate stops meaning anything."
  echo ""
  echo "  Install pnpm for the active Node, or verify by hand and then push:"
  echo "    pnpm build:packages && pnpm typecheck && git push --no-verify"
  exit 1
fi

# A command that was KILLED did not fail — it never finished.
#
# Exit codes above 128 are `128 + signal`: 137 is SIGKILL (the OOM killer, almost always) and 143
# is SIGTERM. Both mean the machine ran out of room or something reached in and stopped the
# process; neither means the code is broken. `tsc` and `tsup` on this repo hold a large heap, so a
# laptop with a browser open reaches that state routinely.
#
# Reporting it as "build failed" sends a developer to look for a defect that does not exist, and —
# worse — trains them to reach for --no-verify on a message that will one day be true. Same
# distinction as the pnpm guard above, and the same reason.
report_stage_failure() {
  stage="$1"
  code="$2"
  echo ""
  if [ "$code" -gt 128 ]; then
    signal=$((code - 128))
    name="signal ${signal}"
    [ "$signal" = "9" ] && name="SIGKILL — the OOM killer, almost certainly"
    [ "$signal" = "15" ] && name="SIGTERM"
    echo "✗ pre-push: ${stage} was KILLED (${name}), not failed — NOTHING was verified."
    echo "  The process did not finish, so it reported no defect. This repo's build and"
    echo "  typecheck hold a large heap; a machine short on memory reaches this routinely."
    echo ""
    echo "  Free some memory and push again, or verify by hand and then push:"
    echo "    pnpm build:packages && pnpm typecheck && git push --no-verify"
  else
    echo "✗ pre-push: ${stage} failed (see error above)."
    echo "  A break must NOT reach develop. Fix it, or push anyway"
    echo "  (emergencies only): git push --no-verify"
  fi
  exit 1
}

echo "→ pre-push: build (--filter ./packages/*) + typecheck (~30-90s). Full suite runs in CI."
echo ""

# Build first — this is the gate that catches a dropped export / fabricated
# symbol (tsup DTS = tsc fails). Filter to packages/* so `pnpm -r build`
# does not walk examples/.
# The status is captured BEFORE any test, because `$?` inside `if ! cmd; then` is the status of
# the NEGATION — always 0 — not of the command. Measured, after writing it the wrong way first.
pnpm build:packages
build_status=$?
if [ "$build_status" -ne 0 ]; then
  report_stage_failure "package build" "$build_status"
fi

pnpm typecheck
typecheck_status=$?
if [ "$typecheck_status" -ne 0 ]; then
  report_stage_failure "typecheck" "$typecheck_status"
fi

echo ""
echo "✓ pre-push gates passed (build + typecheck)"
