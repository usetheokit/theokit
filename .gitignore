# Temporary
tmp/
.tmp/

# Agent tooling state — the whole tree, not a hand-kept list of leaves. A list is what let a
# `git add -A` re-commit the directory after it had been removed.
.claude/

# Python bytecode cache
**/__pycache__/

# Project-specific
ONDAS.md

# Local test project
my-test/

# Read-only study zone: third-party clones, study-only and heavy. Ignored so a fresh checkout of
# one stays untracked. BOTH halves are listed: reference-zone-not-tracked.test.ts asserts the rule
# over both prefixes, and for months only the first was actually excluded — so `git add -A` after a
# clone into the second would have staged every file of a third-party tree, licence included.
knowledge-base/references/
knowledge-base/tools/
.gstack/
architecture-output
architecture-output.old-*

# Local backups
*.bak
.turbo/
architecture-output/

# Python bytecode (Claude Code skill scripts)
__pycache__/
*.pyc

# Generated typecheck pre-flight records (gate documented at wiki/gates/typecheck-pre-flight.md)
.audit/

# Agent tooling scratch output — analysis databases and reports, never project source.
halt-loop-prompts/
clear-project-output/
code-review-output/
