{
  "name": "@theokit/http-decorators",
  "version": "0.3.0",
  "description": "NestJS-style decorators (@Controller, @Get, @Post, @Body, @UseGuards) bridging to TheoKit's defineRoute + defineMiddleware",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theokit-plugin": {
      "import": "./dist/theokit-plugin.js",
      "types": "./dist/theokit-plugin.d.ts"
    },
    "./app": {
      "import": "./dist/app.js",
      "types": "./dist/app.d.ts"
    },
    "./runtime/node": {
      "import": "./dist/runtime-node.js",
      "types": "./dist/runtime-node.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@swc/core": ">=1.3.0",
    "reflect-metadata": "^0.2.2",
    "theokit": ">=0.2.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}
