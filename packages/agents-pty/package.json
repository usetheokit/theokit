{
  "name": "@theokit/agents-pty",
  "version": "0.2.1",
  "description": "The PTY interactive backend for @theokit/agents — a separate package so a web application does not compile a terminal it will never open.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit.git",
    "directory": "packages/agents-pty"
  },
  "homepage": "https://github.com/usetheokit/theokit/tree/main/packages/agents-pty#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@theokit/sdk-pty": ">=0.3.0 <1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
