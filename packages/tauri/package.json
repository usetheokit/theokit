{
  "name": "@theokit/tauri",
  "version": "1.0.0-next.0",
  "description": "Tauri desktop glue for TheoKit agents — the Channel/invoke transport source (webview) + the JSONL sidecar (node), over the unified client. UI is @theokit/ui; the runtime is @theokit/sdk.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit.git",
    "directory": "packages/tauri"
  },
  "homepage": "https://github.com/usetheokit/theokit/tree/main/packages/tauri#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sidecar": {
      "types": "./dist/sidecar.d.ts",
      "import": "./dist/sidecar.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-pack-no-workspace.mjs ."
  },
  "peerDependencies": {
    "theokit": ">=0.65.0-next.0",
    "@tauri-apps/api": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/presenter": "workspace:*",
    "theokit": "workspace:*"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
