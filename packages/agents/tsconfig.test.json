{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "strict": true,
    "paths": {
      "@theokit/http": ["../http/src/index.ts"],
      "@theokit/http/guards": ["../http/src/guards-entry.ts"],
      "@theokit/http/runtime/node": ["../http/src/runtime-node.ts"],
      "@theokit/presenter/wire": ["../presenter/src/wire/index.ts"],
      "@theokit/presenter": ["../presenter/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.test.ts", "scripts/**/*.mts"]
}
