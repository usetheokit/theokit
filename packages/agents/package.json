{
  "name": "@theokit/agents",
  "version": "10.1.0",
  "description": "AI agents as first-class citizens of the TheoKit pipeline. The AgentBuilder.create() authoring chain compiles to the @theokit/sdk runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/usetheokit/theokit/tree/main/packages/agents#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./interactive": {
      "types": "./dist/interactive.d.ts",
      "import": "./dist/interactive.js"
    },
    "./pty": {
      "types": "./dist/pty.d.ts",
      "import": "./dist/pty.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client/react": {
      "types": "./dist/client-react.d.ts",
      "import": "./dist/client-react.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./ask": {
      "types": "./dist/ask.d.ts",
      "import": "./dist/ask.js"
    },
    "./tool-scope": {
      "types": "./dist/tool-scope.d.ts",
      "import": "./dist/tool-scope.js"
    },
    "./mcp-health": {
      "types": "./dist/mcp-health.d.ts",
      "import": "./dist/mcp-health.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/check-pack-no-workspace.mjs ."
  },
  "peerDependencies": {
    "@theokit/http": ">=0.1.0-alpha.0",
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/http": "workspace:*",
    "ai": "7.0.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@theokit/presenter": "workspace:*",
    "@theokit/sdk": "^4.52.1",
    "@theokit/sdk-pty": ">=0.2.0 <1.0.0",
    "@theokit/sdk-tools": "^0.26.1"
  }
}
