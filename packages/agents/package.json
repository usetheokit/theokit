{
  "name": "@theokit/agents",
  "version": "4.2.2",
  "description": "AI agents as first-class citizens of the TheoKit pipeline. The fluent agent()/tool() builders compile to SDK Agent.create() (M31 builder-only authoring API).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bridge": {
      "import": "./dist/bridge.js",
      "types": "./dist/bridge.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./interactive": {
      "types": "./dist/interactive.d.ts",
      "import": "./dist/interactive.js"
    },
    "./pty": {
      "types": "./dist/pty.d.ts",
      "import": "./dist/pty.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@theokit/http": ">=0.1.0-alpha.0",
    "@theokit/sdk": "^4.19.0",
    "@theokit/sdk-pty": ">=0.1.0 <1.0.0",
    "@theokit/sdk-tools": ">=0.11.0 <1.0.0",
    "ai": ">=7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@theokit/sdk-pty": {
      "optional": true
    },
    "@theokit/sdk-tools": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/http": "workspace:*",
    "@theokit/sdk": "^4.19.0",
    "@theokit/sdk-pty": "^0.1.0",
    "@theokit/sdk-tools": "^0.11.0",
    "ai": "^7.0.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "zod": "^4.4.3",
    "@theokit/presenter": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
