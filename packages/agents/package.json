{
  "name": "@theokit/agents",
  "version": "0.6.0",
  "description": "Unified decorator runtime — AI agents as first-class citizens of the TheoKit pipeline. @Agent() compiles to SDK Agent.create(), @Tool() compiles to defineTool().",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./decorators": {
      "import": "./dist/decorators.js",
      "types": "./dist/decorators.d.ts"
    },
    "./bridge": {
      "import": "./dist/bridge.js",
      "types": "./dist/bridge.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@theokit/http": ">=0.1.0-alpha.0",
    "@theokit/sdk": ">=2.5.0",
    "@theokit/sdk-tools": ">=0.2.0",
    "reflect-metadata": ">=0.2.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@theokit/sdk-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/http": "workspace:*",
    "@theokit/sdk": "^2.5.0",
    "@theokit/sdk-tools": "^0.2.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
