{
  "name": "@theokit/agents",
  "version": "7.2.0",
  "description": "AI agents as first-class citizens of the TheoKit pipeline. The fluent agent()/tool() builders compile to SDK Agent.create() (M31 builder-only authoring API).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bridge": {
      "import": "./dist/bridge.js",
      "types": "./dist/bridge.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./interactive": {
      "types": "./dist/interactive.d.ts",
      "import": "./dist/interactive.js"
    },
    "./pty": {
      "types": "./dist/pty.d.ts",
      "import": "./dist/pty.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client/react": {
      "types": "./dist/client-react.d.ts",
      "import": "./dist/client-react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@theokit/http": ">=0.1.0-alpha.0",
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@theokit/sdk-pty": {
      "optional": true
    },
    "@theokit/sdk-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/http": "workspace:*",
    "@theokit/sdk-pty": "^0.2.0",
    "@theokit/sdk-tools": "^0.24.1",
    "ai": "7.0.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@theokit/presenter": "workspace:*",
    "@theokit/sdk": "^4.40.0",
    "@theokit/sdk-pty": ">=0.2.0 <1.0.0",
    "@theokit/sdk-tools": "^0.26.1"
  }
}
