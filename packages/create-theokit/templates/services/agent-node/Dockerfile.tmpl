FROM node:22-alpine

WORKDIR /app

# Install pnpm; a failed prepare must fail the build, not the non-root start
# COREPACK_HOME on a shared path: the non-root runtime user finds the pnpm prepared here
ENV COREPACK_HOME=/usr/local/share/corepack
RUN corepack enable && corepack prepare pnpm@10 --activate

# Copy manifest and install
COPY --chown=1000:1000 package.json ./
RUN pnpm install --frozen-lockfile || npm install

# Copy source
COPY --chown=1000:1000 . .

# Run as the image's non-root node user (uid 1000), never as root
USER 1000:1000

EXPOSE 8002

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget --spider -q http://localhost:8002/health || exit 1

CMD ["pnpm", "start"]
