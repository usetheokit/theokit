// Optional: bundle the terminal app into ONE runnable ESM file (`npm run build:bin`).
// The esbuild settings live in `create-theokit`, so updating that dev dependency updates the build.
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

import { buildInkCli, inkCliBundleOptions } from 'create-theokit/tools/build-ink-cli.mjs'

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')

const paths = (root) => ({
  entry: join(root, 'tui', 'main.tsx'),
  outfile: join(root, 'dist', '{{name}}.mjs'),
})

export function bundleOptions(root = ROOT) {
  return inkCliBundleOptions(paths(root))
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const outfile = await buildInkCli(paths(ROOT))
  process.stdout.write(`built ${outfile}\n`)
}
