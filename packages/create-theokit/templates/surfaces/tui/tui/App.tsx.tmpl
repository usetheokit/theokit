import { Box, Text, useApp, useInput } from 'ink'
import { type ReactElement } from 'react'
import {
  AgentStreaming,
  AgentTimeline,
  AppStatusBar,
  ChatComposer,
  messagesToAgentEvents,
  TheoTUIProvider,
  useTurnElapsed,
  WelcomeBanner,
  type UIMessageLike,
} from '@theokit/tui'
import { InProcessTransport, useAgent } from 'theokit/client'
import { streamAgentTurnInProcess } from 'theokit/server/agent'

import * as chatAgent from '../agents/chat.js'
import { AGENT } from '../shared/agent.js'

/** Shown in the status bar (from `shared/agent.ts`). */
const MODEL = AGENT.model
const CWD = process.cwd()

/** The agent's opening line — the shared greeting plus TUI key hints, so the conversation starts warm. */
const GREETING: UIMessageLike = {
  id: 'greeting',
  role: 'assistant',
  parts: [
    {
      type: 'text',
      text: `${AGENT.greeting} Type below and press Enter · /clear resets · esc cancels.`,
    },
  ],
}

/** Resolve the provider key from the environment (OpenRouter / Anthropic / OpenAI). */
const apiKey = (): string =>
  process.env.OPENROUTER_API_KEY ?? process.env.ANTHROPIC_API_KEY ?? process.env.OPENAI_API_KEY ?? ''

/**
 * The terminal surface, composed from `@theokit/tui` the way a Claude Code / OpenCode / Codex CLI is:
 * `WelcomeBanner` header, a scrolling `<AgentTimeline>` (assistant turns rendered as Markdown + fenced code,
 * tool calls as collapsible cards, thinking rows — the Claude-Code render), a live `<AgentStreaming>` spinner,
 * a bordered `<ChatComposer>`, and a persistent `<AppStatusBar>` footer. Driven by the unified `useAgent`
 * hook (M41).
 *
 * The conversation comes from `useAgent().thread` (M46), projected to the timeline's `AgentEvent[]` by the
 * ai-free `messagesToAgentEvents` — so this terminal surface never imports the `ai` SDK. Prepend the greeting.
 */
const transport = new InProcessTransport({
  run: (input) => streamAgentTurnInProcess(chatAgent, apiKey(), input),
})

export function App(): ReactElement {
  const agent = useAgent<{ message: string }>(transport)
  const streaming = agent.status === 'streaming'
  const elapsed = useTurnElapsed(streaming)
  const { exit } = useApp()

  // The store owns the conversation (M46) — prepend the warm greeting and project to timeline events.
  const events = messagesToAgentEvents([GREETING, ...agent.thread])

  // Esc cancels a running turn, or quits when idle (the Claude Code affordance).
  useInput((_input, key) => {
    if (!key.escape) return
    if (streaming) agent.abort()
    else exit()
  })

  const handleSubmit = (text: string): void => {
    const trimmed = text.trim()
    if (trimmed.length === 0) return
    if (trimmed === '/clear') {
      agent.reset()
      return
    }
    agent.send({ message: trimmed })
  }

  return (
    <TheoTUIProvider theme={{ base: 'dark', override: { accent: 'cyan' } }}>
      <Box flexDirection="column">
        <WelcomeBanner
          name="{{name}}"
          tagline="Your agent, in the terminal — built with TheoKit."
          hints={['Enter sends · Alt+Enter for a newline', '/clear resets · esc cancels a turn or quits']}
        >
          <Text dimColor>cwd: {CWD}</Text>
        </WelcomeBanner>

        <AgentTimeline events={events} />

        {streaming ? <AgentStreaming thought="Thinking…" elapsedSeconds={elapsed} showCancelHint /> : null}
        {agent.error ? <Text color="red">⚠ {agent.error.message}</Text> : null}

        <ChatComposer
          placeholder="Ask your agent…  (Enter sends · / commands · @ files)"
          bordered
          hint="Enter sends · Alt+Enter newline · /clear resets · esc cancels"
          commands={[{ name: 'clear', description: 'clear the conversation' }]}
          onSubmit={handleSubmit}
        />

        <AppStatusBar model={MODEL} cwd={CWD} state={streaming ? 'streaming' : 'idle'} />
      </Box>
    </TheoTUIProvider>
  )
}
