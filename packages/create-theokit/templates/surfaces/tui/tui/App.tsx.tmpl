import { Box, Text, useApp, useInput } from 'ink'
import { type ReactElement, useState } from 'react'
import {
  AgentStreaming,
  AgentTimeline,
  AppStatusBar,
  ChatComposer,
  DEFAULT_COMPOSER_SHORTCUTS,
  findPendingApproval,
  KeyboardHelp,
  messagesToAgentEvents,
  readTurnUsage,
  TheoTUIProvider,
  useTurnElapsed,
  WelcomeBanner,
  type UIMessageLike,
} from '@theokit/tui'
import { InProcessTransport, useAgent } from 'theokit/client'
import { streamAgentTurnInProcess } from 'theokit/server/agent'

import * as chatAgent from '../agents/chat.js'
import { AGENT } from '../shared/agent.js'

/** Shown in the status bar (from `shared/agent.ts`). */
const MODEL = AGENT.model
const CWD = process.cwd()

/** The agent's opening line — the shared greeting plus TUI key hints, so the conversation starts warm. */
const GREETING: UIMessageLike = {
  id: 'greeting',
  role: 'assistant',
  parts: [
    {
      type: 'text',
      text: `${AGENT.greeting} Type below and press Enter · / for commands · @ to mention a file · ? for help.`,
    },
  ],
}

/** Resolve the provider key from the environment (OpenRouter / Anthropic / OpenAI). */
const apiKey = (): string =>
  process.env.OPENROUTER_API_KEY ?? process.env.ANTHROPIC_API_KEY ?? process.env.OPENAI_API_KEY ?? ''

/**
 * The terminal surface, composed from `@theokit/tui` the way a Claude Code / OpenCode / Codex CLI is:
 * `WelcomeBanner` header, a scrolling `<AgentTimeline>` (assistant turns rendered as Markdown + fenced code,
 * tool calls as collapsible cards, thinking rows — the Claude-Code render), a live `<AgentStreaming>` spinner,
 * a bordered `<ChatComposer>`, and a persistent `<AppStatusBar>` footer. Driven by the unified `useAgent`
 * hook (M41).
 *
 * The conversation comes from `useAgent().thread` (M46), projected to the timeline's `AgentEvent[]` by the
 * ai-free `messagesToAgentEvents` — so this terminal surface never imports the `ai` SDK. Prepend the greeting.
 */
const transport = new InProcessTransport({
  run: (input) => streamAgentTurnInProcess(chatAgent, apiKey(), input),
})

export function App(): ReactElement {
  const agent = useAgent<{ message: string }>(transport)
  const streaming = agent.status === 'streaming'
  const elapsed = useTurnElapsed(streaming)
  const { exit } = useApp()
  const [showHelp, setShowHelp] = useState(false)
  // Ctrl+C is a two-step quit (Claude Code): the first press arms the exit + shows a hint, the second
  // quits. Any other key disarms. `render(<App/>, { exitOnCtrlC: false })` in main.tsx hands us Ctrl+C.
  const [exitArmed, setExitArmed] = useState(false)
  // Approval ids already decided — the `approval-requested` part is a STANDALONE gate that never flips to
  // a resolved state (it is keyed by its own id, distinct from the tool call), so we remember settled ids
  // to hide the prompt once answered instead of re-showing it forever.
  const [settledApprovals, setSettledApprovals] = useState<readonly string[]>([])

  // The store owns the conversation (M46) — prepend the warm greeting and project to timeline events.
  const events = messagesToAgentEvents([GREETING, ...agent.thread])

  // Footer telemetry from the per-turn usage the agent stream rides on each assistant message's metadata
  // (readTurnUsage). Context window = the LAST turn's input tokens (what the model saw) over the model's
  // window; cost = the sum across the session. Both stay undefined until the first turn reports usage.
  const usages = agent.thread.map(readTurnUsage).filter((u) => u !== undefined)
  const lastUsage = usages.at(-1)
  const sessionCost = usages.reduce((sum, u) => sum + (u.cost ?? 0), 0)
  const tokens = lastUsage ? { used: lastUsage.inputTokens, limit: AGENT.contextWindow } : undefined

  // Human-in-the-loop: a gated tool (`send_notification`) pauses the run awaiting a decision. When one is
  // pending (and not already settled) we show the approval prompt IN PLACE OF the composer and settle it.
  const rawApproval = findPendingApproval(agent.thread)
  const pendingApproval =
    rawApproval && !settledApprovals.includes(rawApproval.approvalId) ? rawApproval : undefined

  const settleApproval = (approvalId: string, approved: boolean): void => {
    setSettledApprovals((prev) => [...prev, approvalId])
    void agent.approve(approvalId, { approved })
  }

  // Global keys. When a gated tool awaits approval, y/Enter allows it and n/Esc rejects — the run is
  // genuinely paused until then. Otherwise: Esc cancels a running turn / closes help; Ctrl+C cancels a
  // turn, else arms → quits on a second press. The ChatComposer owns editing keys (/, @, !, ?, ↑↓, emacs).
  useInput((input, key) => {
    if (pendingApproval) {
      const answer = input.toLowerCase()
      if (answer === 'y' || key.return) {
        settleApproval(pendingApproval.approvalId, true)
      } else if (answer === 'n' || key.escape) {
        settleApproval(pendingApproval.approvalId, false)
      }
      return
    }
    if (key.escape) {
      if (showHelp) setShowHelp(false)
      else if (streaming) agent.abort()
      return
    }
    if (key.ctrl && input === 'c') {
      if (streaming) {
        agent.abort()
        return
      }
      if (exitArmed) exit()
      else setExitArmed(true)
      return
    }
    if (exitArmed) setExitArmed(false)
  })

  const handleSubmit = (text: string): void => {
    const trimmed = text.trim()
    if (trimmed.length === 0) return
    if (trimmed === '/clear') {
      agent.reset()
      return
    }
    if (trimmed === '/help') {
      setShowHelp((h) => !h)
      return
    }
    agent.send({ message: trimmed })
  }

  return (
    <TheoTUIProvider theme={{ base: 'dark', override: { accent: 'cyan' } }}>
      <Box flexDirection="column">
        <WelcomeBanner
          name="{{name}}"
          tagline="Your agent, in the terminal — built with TheoKit."
          hints={['Enter sends · Alt+Enter for a newline', '/ commands · @ files · ? help · ctrl+c quits']}
        >
          <Text dimColor>cwd: {CWD}</Text>
        </WelcomeBanner>

        <AgentTimeline events={events} />

        {streaming ? <AgentStreaming thought="Thinking…" elapsedSeconds={elapsed} showCancelHint /> : null}
        {agent.error ? <Text color="red">⚠ {agent.error.message}</Text> : null}

        {showHelp ? <KeyboardHelp shortcuts={DEFAULT_COMPOSER_SHORTCUTS} /> : null}

        {pendingApproval ? (
          <Box
            flexDirection="column"
            borderStyle="round"
            borderColor="yellow"
            paddingX={1}
          >
            <Text bold color="yellow">
              ⚠ Allow {pendingApproval.toolName}?
            </Text>
            <Text dimColor>{JSON.stringify(pendingApproval.input)}</Text>
            <Text>
              <Text color="green">[y]</Text> allow · <Text color="red">[n]</Text> reject
            </Text>
          </Box>
        ) : (
          <ChatComposer
            placeholder="Ask your agent…  (Enter sends · / commands · @ files · ? help)"
            bordered
            hint={
              exitArmed
                ? 'Press Ctrl+C again to quit'
                : 'Enter sends · Alt+Enter newline · / commands · @ files · ? help · esc cancels'
            }
            commands={[
              { name: 'clear', description: 'clear the conversation' },
              { name: 'help', description: 'toggle the keyboard shortcuts panel' },
            ]}
            onHelpToggle={() => setShowHelp((h) => !h)}
            onSubmit={handleSubmit}
          />
        )}

        <AppStatusBar
          model={MODEL}
          cwd={CWD}
          tokens={tokens}
          cost={sessionCost > 0 ? sessionCost : undefined}
          state={streaming ? 'streaming' : 'idle'}
        />
      </Box>
    </TheoTUIProvider>
  )
}
