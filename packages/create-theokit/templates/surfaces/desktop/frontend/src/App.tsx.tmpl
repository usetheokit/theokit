import { useEffect, useState, type CSSProperties, type ReactElement } from 'react'
import {
  ChatThread,
  ChatMessage,
  ChatComposer,
  AgentStreaming,
  AgentErrorCard,
  QuickActionChips,
  TheoUIProvider,
  ThemeSwitcher,
  type UIMessage,
  type QuickAction,
} from '@theokit/ui'
import { Button } from '@usetheo/ui'
import { createTauriChannelSource, type TauriCore } from '@theokit/tauri'
import { Bot, Plus, Sparkles } from 'lucide-react'
import { ChannelTransport, useAgent } from 'theokit/client'

import { AGENT } from '../../shared/agent'

/**
 * M47 — the desktop webview renders the SAME agent-chat surface as the default web scaffold, from the exact
 * same `@theokit/ui` components (`ChatThread` / `ChatMessage` / `ChatComposer` / `AgentStreaming` /
 * `AgentErrorCard` / `QuickActionChips`). The ONLY difference from web is the transport: a `ChannelTransport`
 * whose source is `@theokit/tauri`'s `createTauriChannelSource` (the Tauri `Channel`/`invoke` bridge) instead
 * of an HTTP path — `useAgent` is transport-agnostic, so the UI code is identical.
 *
 * `@theokit/ui` components ship their own styles in the precompiled `styles.css`, so they render styled with
 * no Tailwind toolchain here; the app-level LAYOUT uses inline styles (reading the theme CSS vars, so
 * `ThemeSwitcher` still cascades) because the desktop bundle is plain Vite, not the framework's Tailwind build.
 */

const MODEL_NAME = AGENT.model

// `withGlobalTauri: true` (tauri.conf.json) injects this global; the module throws early if the app is opened
// outside the desktop shell (e.g. a plain browser) so the failure is loud, not a silent white screen.
const tauri = (globalThis as { __TAURI__?: { core: TauriCore } }).__TAURI__
if (tauri === undefined) {
  throw new Error('Tauri globals unavailable — run inside the desktop shell (`npm run dev`).')
}
const transport = new ChannelTransport({ source: createTauriChannelSource(tauri.core) })

/** The agent's opening line (from `shared/agent.ts`) — so the conversation starts warm instead of empty. */
const GREETING: UIMessage = {
  id: 'greeting',
  role: 'assistant',
  parts: [{ type: 'text', text: AGENT.greeting }],
}

/** Honest starter prompts — each sends a real message the scaffold agent can actually answer. */
const STARTERS: QuickAction[] = [
  { id: 'help', label: 'What can you help me with?', icon: Sparkles },
  { id: 'haiku', label: 'Write a haiku about TypeScript', icon: Sparkles },
  { id: 'async', label: 'Explain async/await in one paragraph', icon: Sparkles },
]

// App-level layout in inline styles (the desktop bundle has no Tailwind). Colors read the theme CSS vars
// `@theokit/ui` sets, so light/dark + the theme switcher cascade exactly like the web surface.
const styles = {
  page: {
    display: 'flex',
    flexDirection: 'column',
    height: '100vh',
    background: 'hsl(var(--background))',
    color: 'hsl(var(--foreground))',
  },
  header: {
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'space-between',
    borderBottom: '1px solid hsl(var(--border) / 0.6)',
    padding: '8px 16px',
  },
  brand: { display: 'inline-flex', alignItems: 'center', gap: 8 },
  brandName: { fontWeight: 600, fontSize: 13, letterSpacing: '-0.01em' },
  scroll: { flex: 1, overflowY: 'auto', minHeight: 0 },
  column: {
    margin: '0 auto',
    display: 'flex',
    flexDirection: 'column',
    gap: 16,
    width: '100%',
    maxWidth: 768,
    padding: 24,
  },
  composerBar: {
    borderTop: '1px solid hsl(var(--border) / 0.6)',
    background: 'hsl(var(--background) / 0.5)',
  },
  composerInner: { margin: '0 auto', width: '100%', maxWidth: 768, padding: '16px 24px' },
} satisfies Record<string, CSSProperties>

export function App(): ReactElement {
  const [composerValue, setComposerValue] = useState('')
  const [history, setHistory] = useState<UIMessage[]>([GREETING])
  const { messages, send, status, reset, error } = useAgent<{ message: string }>(transport)

  const isStreaming = status === 'streaming'
  const hasError = status === 'error'

  const users = history.filter((m) => m.role === 'user').length
  const replies = history.filter((m) => m.role === 'assistant' && m.id !== 'greeting').length
  // A sent prompt is still awaiting its committed reply — the current turn is "in flight".
  const pending = users > replies

  // Merge the in-flight turn's parts into ONE assistant message with our own unique id (the SDK's ids are
  // empty, which would collide). `suffix` distinguishes the live copy from the committed one.
  const inflightReply = (suffix: string): UIMessage => ({
    id: `a-${String(replies)}${suffix}`,
    role: 'assistant',
    parts: messages.flatMap((m) => m.parts),
  })

  // Commit the finished reply into history exactly once (the next send resets `messages`).
  useEffect(() => {
    if (!isStreaming && pending && messages.length > 0) {
      setHistory((h) => [...h, inflightReply('')])
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [isStreaming, pending, messages, replies])

  // Transcript = committed history + the in-flight reply (shown until it commits — no flicker, no double).
  const thread = pending && messages.length > 0 ? [...history, inflightReply('-live')] : history
  const onlyGreeting = history.length === 1 && !isStreaming

  function handleSubmit(value: string): void {
    const trimmed = value.trim()
    if (trimmed.length === 0) return
    setHistory((h) => [
      ...h,
      { id: `u-${String(h.length)}`, role: 'user', parts: [{ type: 'text', text: trimmed }] },
    ])
    send({ message: trimmed })
    setComposerValue('')
  }

  function newChat(): void {
    setHistory([GREETING])
    reset()
    setComposerValue('')
  }

  return (
    <TheoUIProvider>
      <div style={styles.page}>
        <header style={styles.header}>
          <span style={styles.brand}>
            <Bot size={18} style={{ color: 'hsl(var(--primary))' }} aria-hidden />
            <span style={styles.brandName}>{{name}} — TheoKit agent</span>
          </span>
          <ThemeSwitcher />
        </header>

        <div style={styles.scroll}>
          <div style={styles.column}>
            <ChatThread>
              {thread.map((message) => (
                <ChatMessage key={message.id} message={message} />
              ))}
              {isStreaming && <AgentStreaming model={MODEL_NAME} />}
            </ChatThread>
            {onlyGreeting && (
              <QuickActionChips
                actions={STARTERS}
                onSelect={(id) => {
                  const action = STARTERS.find((s) => s.id === id)
                  if (action && typeof action.label === 'string') handleSubmit(action.label)
                }}
              />
            )}
          </div>
        </div>

        <div style={styles.composerBar}>
          <div style={styles.composerInner}>
            {hasError && (
              <div style={{ marginBottom: 12 }}>
                <AgentErrorCard
                  kind="network"
                  title="The agent stream ended with an error"
                  detail={error?.message ?? 'Something went wrong. Start a new chat to try again.'}
                  actions={
                    <Button variant="ghost" size="sm" onClick={newChat}>
                      New chat
                    </Button>
                  }
                />
              </div>
            )}
            <ChatComposer
              value={composerValue}
              onValueChange={setComposerValue}
              onSubmit={handleSubmit}
              running={isStreaming}
              placeholder="Message the agent…"
              leadingActions={
                <Button
                  type="button"
                  variant="ghost"
                  size="icon"
                  onClick={newChat}
                  aria-label="New chat"
                  title="New chat"
                >
                  <Plus className="size-4" />
                </Button>
              }
            />
          </div>
        </div>
      </div>
    </TheoUIProvider>
  )
}
