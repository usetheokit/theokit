{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{name}}",
  "version": "0.1.0",
  "identifier": "dev.theokit.{{name}}",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/build-sidecar.mjs && vite frontend",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs && vite build frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "{{name}} — TheoKit desktop",
        "width": 900,
        "height": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/theo-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
