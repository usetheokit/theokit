{
  "name": "@theokit/http",
  "version": "1.0.0",
  "description": "NestJS-style decorators (@Controller, @Get, @Post, @Body, @UseGuards) bridging to TheoKit's defineRoute + defineMiddleware",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theokit-plugin": {
      "import": "./dist/theokit-plugin.js",
      "types": "./dist/theokit-plugin.d.ts"
    },
    "./app": {
      "import": "./dist/app.js",
      "types": "./dist/app.d.ts"
    },
    "./runtime/node": {
      "import": "./dist/runtime-node.js",
      "types": "./dist/runtime-node.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@swc/core": ">=1.3.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.0.0",
    "@theokit/agents": ">=0.47.0"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@theokit/agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
