{
  "name": "@theokit/http",
  "version": "1.1.1",
  "description": "NestJS-style decorators (@Controller, @Get, @Post, @Body, @UseGuards) over Web Standards, compiling to TheoKit route registrations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/usetheokit/theokit/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/usetheokit/theokit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theokit-plugin": {
      "types": "./dist/theokit-plugin.d.ts",
      "import": "./dist/theokit-plugin.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./runtime/node": {
      "types": "./dist/runtime-node.d.ts",
      "import": "./dist/runtime-node.js"
    },
    "./action-encryption": {
      "types": "./dist/action-encryption.d.ts",
      "import": "./dist/action-encryption.js"
    },
    "./server-inserted-html": {
      "types": "./dist/server-inserted-html.d.ts",
      "import": "./dist/server-inserted-html.js"
    },
    "./css-resource": {
      "types": "./dist/css-resource.d.ts",
      "import": "./dist/css-resource.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-pack-no-workspace.mjs ."
  },
  "peerDependencies": {
    "@swc/core": ">=1.3.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
