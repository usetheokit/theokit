# TheoClaw environment. Copy to `.env` (git ignores it) and fill in the platforms you use.
# A platform with any variable missing or blank is skipped, and startup names the missing ones.
# Load it with `node --env-file=.env` or `set -a; . ./.env; set +a`.

# Required
THEOCLAW_MODEL=            # e.g. openrouter/google/gemini-2.5-flash-lite (needs OPENROUTER_API_KEY)
THEOCLAW_PORT=8787         # HTTP port for /health, the webhook routes and /control, integer 0 to 65535
THEOCLAW_OWNERS=           # who the instance serves: platform:senderId, comma-separated, e.g. telegram:42
THEOCLAW_STATE_DIR=        # where pairing.json is kept; required under THEOCLAW_DM_POLICY=pairing (the default)
THEOCLAW_WORKSPACE=        # absolute path of an existing directory; chat transcripts go to <it>/.theoclaw (leave unset under THEOCLAW_PROFILE)
# The model key: set one. THEOKIT_API_KEY wins when both are set.
THEOKIT_API_KEY=
OPENROUTER_API_KEY=

# Optional
THEOCLAW_HOST=             # address to bind; 127.0.0.1 when unset
THEOCLAW_PUBLIC_BIND=      # set to yes to allow a THEOCLAW_HOST that is not a loopback address
THEOCLAW_CONTROL_TOKEN=    # at least 32 characters; turns on the /control socket, off while unset
THEOCLAW_MDNS=             # off stops the LAN announcement (_theoclaw._tcp); on or unset announces a LAN bind
THEOCLAW_PROFILE=          # a name (^[a-z0-9][a-z0-9-]{0,15}$): state under ~/.theokit/profiles/<name>, label theoclaw-<name>; not with THEOKIT_HOME, THEOKIT_AUTH_HOME or THEOCLAW_STATE_DIR
THEOCLAW_DM_POLICY=        # pairing (default), allowlist, open or disabled: what a DM from anyone else gets
THEOCLAW_REFUSAL_TEXT=     # the refusal under allowlist; "This assistant answers its owner only." when unset
THEOCLAW_GROUP_ACTIVATION= # mention (default) or always: whether a group message must mention the bot
THEOCLAW_BROADCAST_GROUPS="" # double-quote the value (the shell loader cuts it at ";"): "name=platform:channelId,platform:channelId;name2=..." channels sharing one thread
THEOCLAW_ACCESS_GROUPS="" # double-quote the value: "name=platform:senderId,platform:senderId;name2=..." named sender lists
THEOCLAW_ALLOWLIST=        # platform:senderId or platform:accessGroup:<name>, comma-separated: senders answered besides the owners
THEOCLAW_WEBCHAT_TOKEN=    # at least 32 characters; turns on /webchat, off while unset (build the page with build:web)
THEOCLAW_CONFIG=           # the configuration file the entry loads; ~/.config/theoclaw/theoclaw.env (or theoclaw-<profile>.env) when unset; a variable set here wins over it
THEOCLAW_UPDATE_CHANNEL=   # stable (default, follows main) or dev (follows develop): the channel theoclaw update follows
THEOCLAW_IMPORTED_MCP=     # "on" gives the /control agent the MCP servers of a migration import (pnpm run import); off while unset, any other value stops the start

# Tools of the /control turn's agent (B-382). Chat replies never get tools.
THEOCLAW_HOST_TOOLS=       # "on" adds write, edit, apply_patch and a sandboxed shell; needs bwrap, refused under /tmp or with THEOCLAW_STATE_DIR under files/ or /tmp
THEOCLAW_SANDBOX=          # the shell's sandbox with host tools on (B-392): read-only, workspace-write (default) or danger-full-access (no sandbox)
THEOCLAW_EXTERNAL_TOOLS=   # path of a JSON file of MCP servers and ACP agents for the /control agent; see README
BRAVE_API_KEY=             # turns on web search over Brave; wins over the generic adapter below
THEOKIT_SEARCH_API_URL=    # a generic search endpoint (GET ?q=&n=, Bearer key); set with its key or not at all
THEOKIT_SEARCH_API_KEY=

# Chat sessions (optional)
THEOCLAW_DM_SCOPE=              # main, per-peer, per-channel-peer (default) or per-account-channel-peer
THEOCLAW_PEER_LINKS=            # per-peer only: telegram:123=paulo,discord:456=paulo (one session per name)
THEOCLAW_ACCOUNT_LABEL=         # required by per-account-channel-peer, e.g. work
THEOCLAW_SESSION_IDLE_MINUTES=  # minutes an idle chat agent stays open, 1 to 1440; default 30
THEOCLAW_MAX_OPEN_SESSIONS=     # chat agents kept open at most, 1 to 10000; default 200

# Telegram (long polling)
THEOCLAW_TELEGRAM_TOKEN=

# Discord (gateway; enable the Message Content intent)
THEOCLAW_DISCORD_TOKEN=

# Slack (Socket Mode: bot token xoxb-, app-level token xapp- with connections:write)
THEOCLAW_SLACK_BOT_TOKEN=
THEOCLAW_SLACK_APP_TOKEN=

# Matrix
THEOCLAW_MATRIX_HOMESERVER_URL=   # e.g. http://127.0.0.1:8008
THEOCLAW_MATRIX_ACCESS_TOKEN=
THEOCLAW_MATRIX_USER_ID=          # e.g. @theoclaw:localhost

# Mattermost (bot account access token)
THEOCLAW_MATTERMOST_BASE_URL=     # e.g. http://127.0.0.1:8065
THEOCLAW_MATTERMOST_ACCESS_TOKEN=

# Raft External Agent (the `raft` CLI wake bridge, logged in; no webhook, no secret)
# Set to 1 to enable. Optional: THEOCLAW_RAFT_CLI_PATH (default: raft on PATH)
THEOCLAW_RAFT_ENABLED=
THEOCLAW_RAFT_CLI_PATH=

# X (Twitter): mentions of the bot account become threads; public replies only to the allowlist (no DMs, likes or media)
# OAuth 2.0 confidential app of the bot account; THEOCLAW_X_ALLOW_FROM is a comma list of handles or user ids.
# Optional: THEOCLAW_X_BEARER_TOKEN; THEOCLAW_X_GUEST_DAILY_LIMIT (a positive integer answers other authors, that many a day each).
# X rotates the refresh token: the new one is kept in THEOCLAW_STATE_DIR/x-refresh-token.
THEOCLAW_X_USER_ID=
THEOCLAW_X_USERNAME=
THEOCLAW_X_CLIENT_ID=
THEOCLAW_X_CLIENT_SECRET=
THEOCLAW_X_REFRESH_TOKEN=
THEOCLAW_X_ALLOW_FROM=
THEOCLAW_X_BEARER_TOKEN=
THEOCLAW_X_GUEST_DAILY_LIMIT=

# WeChat Official Account (webhook: /webhooks/wechat)
THEOCLAW_WECHAT_APP_ID=
THEOCLAW_WECHAT_APP_SECRET=
THEOCLAW_WECHAT_TOKEN=

# WeCom self-built application (webhook: /webhooks/wecom)
THEOCLAW_WECOM_CORP_ID=
THEOCLAW_WECOM_CORP_SECRET=
THEOCLAW_WECOM_AGENT_ID=
THEOCLAW_WECOM_TOKEN=
THEOCLAW_WECOM_ENCODING_AES_KEY=

# Yuanbao bot (webhook: /webhooks/yuanbao)
THEOCLAW_YUANBAO_APP_ID=
THEOCLAW_YUANBAO_APP_SECRET=
THEOCLAW_YUANBAO_CALLBACK_SECRET=

# QQ Bot, direct messages (webhook: /webhooks/qq)
THEOCLAW_QQ_APP_ID=
THEOCLAW_QQ_APP_SECRET=

# Zalo Official Account (webhook: /webhooks/zalo); the access token expires, supply a fresh one
THEOCLAW_ZALO_APP_ID=
THEOCLAW_ZALO_OA_SECRET_KEY=
THEOCLAW_ZALO_ACCESS_TOKEN=

# Tlon/Urbit (the ship's HTTP URL, its @p and its +code, which is a secret)
THEOCLAW_TLON_URBIT_SHIP_URL=     # e.g. http://127.0.0.1:8080
THEOCLAW_TLON_URBIT_SHIP=         # e.g. ~sampel-palnet
THEOCLAW_TLON_URBIT_CODE=

# E-mail (IMAP to read, SMTP to send)
THEOCLAW_EMAIL_ADDRESS=
THEOCLAW_EMAIL_PASSWORD=
THEOCLAW_EMAIL_IMAP_HOST=
THEOCLAW_EMAIL_SMTP_HOST=

# LINE Messaging API (webhook: /webhooks/line)
THEOCLAW_LINE_CHANNEL_SECRET=
THEOCLAW_LINE_CHANNEL_ACCESS_TOKEN=

# WhatsApp Cloud API (webhook: /webhooks/whatsapp)
THEOCLAW_WHATSAPP_ACCESS_TOKEN=
THEOCLAW_WHATSAPP_PHONE_NUMBER_ID=
THEOCLAW_WHATSAPP_APP_SECRET=
THEOCLAW_WHATSAPP_VERIFY_TOKEN=   # any string; the same value goes in the Meta webhook config

# Microsoft Teams (Bot Framework; needs a work tenant)
THEOCLAW_TEAMS_CLIENT_ID=
THEOCLAW_TEAMS_CLIENT_SECRET=
THEOCLAW_TEAMS_TENANT_ID=

# Google Chat (Chat app HTTP endpoint: https://<host>/webhooks/google_chat)
# Path of the service account's JSON key file, and the endpoint URL set in the Chat app (the token audience)
THEOCLAW_GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=
THEOCLAW_GOOGLE_CHAT_AUDIENCE=

# Signal (signal-cli linked to a number; no webhook)
# Optional; default: signal-cli on PATH
THEOCLAW_SIGNAL_CLI_PATH=
THEOCLAW_SIGNAL_ACCOUNT=

# iMessage (macOS only, Messages signed in, `imsg` installed; no webhook)
# Set to 1 to enable. Optional: THEOCLAW_IMESSAGE_CLI_PATH (default: imsg on PATH), THEOCLAW_IMESSAGE_DB_PATH
THEOCLAW_IMESSAGE_ENABLED=
THEOCLAW_IMESSAGE_CLI_PATH=
THEOCLAW_IMESSAGE_DB_PATH=

# SMS through Twilio (webhook: /webhooks/sms)
THEOCLAW_SMS_TWILIO_ACCOUNT_SID=
THEOCLAW_SMS_TWILIO_AUTH_TOKEN=
THEOCLAW_SMS_TWILIO_FROM_NUMBER=  # E.164, e.g. +15550000000
THEOCLAW_SMS_PUBLIC_URL=          # the exact public URL Twilio posts to, used to check signatures
