  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:live": "vitest run tests/live --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src tests",
    "lint": "eslint .",
    "parity": "node tools/check-parity-ledger.mjs",
    "check:versions": "node tools/check-exact-versions.mjs package.json",
    "audit": "node tools/audit-theoclaw.mjs"
  }
