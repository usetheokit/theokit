    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/dns-packet": "5.6.5",
    "@types/node": "22.20.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "dns-packet": "5.6.1",
    "eslint": "9.39.4",
